# Jellyfin server URL. Example: http://192.168.1.50:8096
JELLYFIN_URL=

# Jellyfin API token (Dashboard -> API Keys)
JELLYFIN_API_TOKEN=

# Display mode: "regular" (HDMI / TV / desktop monitor with crossfade GUI)
# or "eink" (headless Waveshare 7.3" PhotoPainter e-Paper display)
DISPLAY_TYPE=regular

# How often to check Jellyfin for active movie playback (seconds).
REFRESH_SECONDS=30

# How often to rotate idle posters on either display type (minutes).
IDLE_REFRESH_MINUTES=30

# Number of most-recent posters retained for offline display.
POSTER_CACHE_SIZE=10

# Background color for canvas borders
BACKGROUND_COLOR=black

# Optional comma-separated movie titles. If set, poster rotation only uses these titles.
# Example: SELECT_MOVIES=Inception,The Matrix,Interstellar
SELECT_MOVIES=

# Jellyfin media types to include: Movie, Series, or both.
MEDIA_TYPES=Movie
# Optional comma-separated genres; matches media tagged with any listed genre.
# Example: GENRES=Action,Comedy
GENRES=
# Optional comma-separated genres to always exclude, even during holiday mode.
# Example: EXCLUDED_GENRES=Documentary,News
EXCLUDED_GENRES=

# Optional seasonal genre selection. Set true to enable holiday-specific genres.
# Add holiday names to HOLIDAYS as a comma-separated list. For each holiday define:
#   <NORMALIZED_NAME>_GENRE=<Jellyfin genre tag(s)> (comma-separated; matches any)
#   <NORMALIZED_NAME>_DAYS=MM/DD-MM/DD (inclusive, repeats yearly)
# Normalize names to uppercase, replacing spaces/punctuation with underscores:
# Valentine's Day -> VALENTINE_S_DAY_GENRE and VALENTINE_S_DAY_DAYS.
# Date ranges may cross New Year, e.g. 12/20-01/05.
# To add a custom holiday, add its name to HOLIDAYS and define both variables.
# Example: HOLIDAYS=...,Spring Break; SPRING_BREAK_GENRE=Adventure,Family
#          SPRING_BREAK_DAYS=03/15-03/31
HOLIDAY_MODE=false
HOLIDAYS=Christmas,Independence Day,Halloween,Thanksgiving
CHRISTMAS_GENRE=Christmas
CHRISTMAS_DAYS=12/18-12/31
INDEPENDENCE_DAY_GENRE=Action
INDEPENDENCE_DAY_DAYS=07/01-07/07
HALLOWEEN_GENRE=Horror
HALLOWEEN_DAYS=10/20-10/31
THANKSGIVING_GENRE=Family
THANKSGIVING_DAYS=11/20-11/30

# --- Regular Screen (HDMI / GUI) Settings ---
# Fade transition speed: 1 (slowest, ~5.5 s) to 10 (fastest, ~0.05 s). Default: 8 (~0.4 s)
FADE_SPEED=8
# Set to true to run in fullscreen on Raspberry Pi HDMI output
FULLSCREEN=true

# --- E-Ink Screen (Waveshare PhotoPainter 7.3") Settings ---
# Display resolution (PhotoPainter 7.3" is 800x480)
EINK_WIDTH=800
EINK_HEIGHT=480
# Rotation in degrees: 0, 90, 180, 270 (Set to 180 if frame orientation is reversed)
EINK_ROTATION=0
# PhotoPainter custom power pin (BCM 27)
EINK_PWR_PIN=27
# Path to save preview image (useful for testing on PC/Mac without hardware)
EINK_PREVIEW_PATH=eink_preview.png
